MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 249014753}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e0d5a4a19af35bb4dba20fd1dcccefe6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  localizationTexts:
  - key: COMMAND_PALETTE
    russian: "\u041A\u043E\u043C\u0430\u043D\u0434\u044B"
    english: Commands
  - key: 'MOVE_FORWARD '
    russian: "\u0412\u043F\u0435\u0440\u0435\u0434"
    english: Move Forward
  - key: TURN_LEFT
    russian: "\u041F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043B\u0435\u0432\u043E"
    english: TurnLeft
  - key: TURN_RIGHT
    russian: "\u041F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E"
    english: TurnRight
  - key: JUMP
    russian: "\u041F\u0440\u044B\u0436\u043E\u043A"
    english: Jump
  - key: INTERACT
    russian: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C"
    english: Interact
  - key: IF
    russian: "\u0415\u0441\u043B\u0438"
    english: if
  - key: ELSE
    russian: "\u0418\u043D\u0430\u0447\u0435"
    english: Else
  - key: PRESS_START_TO_RUN
    russian: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u0421\u0422\u0410\u0420\u0422
      \u0434\u043B\u044F \u0437\u0430\u043F\u0443\u0441\u043A\u0430"
    english: PRESS START TO RUN
  - key: DRAG_BLOCKS_HERE
    russian: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0431\u043B\u043E\u043A\u0438
      \u0441\u044E\u0434\u0430"
    english: DRAG BLOCKS HERE
  - key: LOSE_TITLE
    russian: "\u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435!"
    english: Lose
  - key: TRY_AGAIN
    russian: "\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439 \u0435\u0449\u0435
      \u0440\u0430\u0437"
    english: Try again
  - key: COMMAND_PALETTE
    russian: "\u041A\u043E\u043C\u0430\u043D\u0434\u044B"
    english: COMMAND
